# Raise Scoreboard settings. All optional; set them on GitHub as repository *variables* (none is a secret).
SB_BASE_URL=            # canonical origin + path; default https://theguysaccount.github.io/espn-of-venture
SB_CUSTOM_DOMAIN=       # e.g. silicontank.com; writes dist/CNAME (set SB_BASE_URL to https://<domain> too)
SB_GOATCOUNTER=         # https://<code>.goatcounter.com/count  cookieless page and event counts
SB_SPONSOR_URL=         # the money slot: a sponsor link shown in a marked box in the footer
EDGAR_CONTACT_EMAIL=    # a real, monitored contact mailbox; switches on direct, same-day pulls from SEC EDGAR
SB_REPO=                # owner/name for correction links
SB_OUT=                 # build output directory; default dist/
CHROME=                 # Chrome/Chromium binary for share images
